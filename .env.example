# ============================================================
#  KorianMC Bot - Variables de entorno
#  Copia este archivo como ".env" y rellena tus valores.
#  NUNCA subas el archivo .env a Git ni lo compartas.
# ============================================================

# --- OBLIGATORIO -------------------------------------------------
# Token de tu bot desde el Discord Developer Portal (pestaña "Bot").
DISCORD_TOKEN=MTU2NjE0NDYwMjEwMzA5NTMzNg.GdXLHD.g4QF2pm8KML_wcQvKN9-YjEZJy4l1W7ZRZKz7w

# --- GEMINI (IA) -------------------------------------------------
# Clave gratuita en https://aistudio.google.com/apikey
# Sin esta clave el bot arranca igual: los módulos de IA se desactivan solos.
GEMINI_API_KEY=AQ.Ab8RN6ISEcJWKxFUn4A4Ua90tmTJLF1o-L9bqAzowtd1LlHRnQ
GEMINI_MODEL=gemini-1.5-flash
# Segundos máximos de espera a Gemini antes de responder con aviso.
AI_TIMEOUT=30

# --- APARIENCIA / IDIOMA ----------------------------------------
# Color principal de los embeds (por defecto #5865F2).
BOT_COLOR=#5865F2
# Prefijos por coma para los comandos de texto.
BOT_PREFIXES=! ,/

# --- REGISTRO Y COPIAS DE SEGURIDAD ----------------------------
LOG_LEVEL=INFO
# Copia automática de la base de datos cada N horas (0 = desactivado).
BACKUP_INTERVAL_HOURS=6

# --- PANEL WEB ADMIN (Express) ----------------------------------
# Déjalo en "false" hasta que configures el panel.
PANEL_ENABLED=false
PANEL_PORT=3000
PANEL_TOKEN=cambia_este_token_largo_y_secreto

# --- PAGOS (desactivados hasta configurar) ----------------------
# Con claves vacías el bot no ofrece pagos y sigue funcionando.
PAYMENTS_PROVIDER=none
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
PAYPAL_CLIENT_ID=
PAYPAL_SECRET=
